    <properties>
        <!-- 版本口径由 parent 下发。下面删掉的 8 格是现算的（parent_preflight 第 2 节"同值可删"）：
             java.version=1.8 / mybatis-plus.version=3.5.7 / spring-boot.version=2.7.18 /
             z-graph.version=1.0.7 / z-util.version=1.0.13 与父链面值逐字节相同，
             maven.compiler.source/target=1.8 与 project.build.sourceEncoding=UTF-8 由父链供
