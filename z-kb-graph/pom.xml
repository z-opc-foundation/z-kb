    <groupId>io.github.yuku123</groupId>
    <version>1.0.1</version>

    <artifactId>z-kb-graph</artifactId>
    <packaging>jar</packaging>
    <name>z-kb-graph</name>
    <description>
        z-kb 图谱适配 — 封装 z-graph，提供 KnowledgeGraphStore 和 GraphRAG 查询。
        将 Entity/Relation 映射到 z-graph 的 Node/Edge。
        支持：实体-关系三元组存储、多跳遍历、子图查询、版本快照。
    </description>

    <url>https://github.com/yuku123/z-kb</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/yuku123/z-kb.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yuku123/z-kb.git</developerConnection>
        <url>https://github.com/yuku123/z-kb</url>
        <tag>HEAD</tag>
    </scm>



    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-kb-api</artifactId>
            <version>1.0.1</version>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-graph-api</artifactId>
            <version>1.0.1</version>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-graph-core</artifactId>
            <version>1.0.1</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <!-- Jackson — JsonFileKnowledgeGraphStore 序列化 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson-databind.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>${log4j2.version}</version>
