        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/yuku123/z-kb.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yuku123/z-kb.git</developerConnection>
        <url>https://github.com/yuku123/z-kb</url>
        <tag>HEAD</tag>
    </scm>



    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-kb-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-kb-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-kb-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-kb-ingest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-kb-modeling</artifactId>
        </dependency>

        <!-- Swagger 注解（@Api / @ApiOperation）：7 个 controller 直接用 ⇒ 消费方 classpath 上必须有它。
             只带注解包（io.swagger:swagger-annotations 1.x），不带 springfox 本体。 -->
        <dependency>
            <groupId>io.swagger</groupId>
            <artifactId>swagger-annotations</artifactId>
            <version>1.6.6</version>
        </dependency>

        <!-- Knife4j / springfox（SwaggerConfig 用）：**optional**。
             宿主 z-opc 自己已装 knife4j-spring-boot-starter 3.0.3 + knife4j-openapi3 4.1.0
             （springfox 3.0.0 那条线）；本依赖若按普通传递依赖透传，会把 knife4j-core 4.5.0
             与 spring-boot-starter-security 一起塞进宿主 ⇒ 同包不同版本的 knife4j-core 共存，
             宿主文档面随时可能炸。改成 optional：z-kb-web 自己编译/单跑仍带 springfox，
             宿主要文档面就自己装；自动装配也不扫 SwaggerConfig（见 KbWebAutoConfiguration）。 -->
        <dependency>
            <groupId>com.github.xiaoymin</groupId>
            <artifactId>knife4j-openapi2-spring-boot-starter</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>2.7.12</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
            <version>2.7.12</version>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>2.7.12</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
