            <artifactId>z-kb-ingest</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-kb-modeling</artifactId>
        </dependency>

        <!-- Swagger 注解（2026-10-30 起是 io.swagger.core.v3 的 @Schema/@Operation/@Tag，
             **-jakarta 变体**，与 springdoc 2.6.0 自带的那条线同源）：7 个 controller 直接用
             ⇒ 编译期必须有。坐标与版本走根 DM（2.2.22），此处不再自钉 1.6.6。 -->
        <dependency>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations-jakarta</artifactId>
        </dependency>

        <!-- 文档面运行时（SwaggerConfig 用）：**optional**。
             2026-10-30 从 knife4j-openapi2（springfox 2.10.5）换成 springdoc 2.6.0 —— 老的
             springfox 类里引用 javax/servlet，SB3 容器只有 jakarta，SwaggerConfig 一被扫到就
             NoClassDefFoundError。仍保持 optional：宿主 z-opc 自带 springdoc + knife4j-openapi3-jakarta，
             本 jar 不该把第二套文档面塞进宿主；z-kb-web 自己编译/单跑时它就在 classpath 上。
             自动装配不扫 SwaggerConfig（见 KbWebAutoConfiguration），只在 standalone 生效。 -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 2026-10-30：三个 starter 的 2.7.12 字面量删掉。它们从来没真正生效过 —— 父链 DM
             把 spring-web/webmvc 拉回 6.1.21，只有 starter 自己的 pom 还停在 2.7.12；
             留着就是「声明与事实不一致」，DM 一改就会静默降级回 Spring 5。版本一律由父链下发。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>${slf4j.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
