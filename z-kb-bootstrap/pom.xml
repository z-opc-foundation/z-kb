<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
            <artifactId>z-***REMOVED***</artifactId>
        <version>1.1.0</version>
    </parent>
    <groupId>io.github.yuku123</groupId>
    <version>1.1.0</version>

    <artifactId>z-***REMOVED***-bootstrap</artifactId>
    <packaging>jar</packaging>
    <name>z-***REMOVED*** :: bootstrap</name>
    <description>
        z-***REMOVED*** 启动器 — 独立可执行的 Spring Boot 应用，默认端口 8889。
        集成所有 z-***REMOVED*** 子模块 + Knife4j，开箱即用。
    </description>

    <url>https://github.com/yuku123/z-***REMOVED***</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/yuku123/z-***REMOVED***.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yuku123/z-***REMOVED***.git</developerConnection>
        <url>https://github.com/yuku123/z-***REMOVED***</url>
        <tag>HEAD</tag>
    </scm>



    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-***REMOVED***-web</artifactId>
        </dependency>

        <!-- ==================== 日志面（2026-11-01 补） ====================
             为什么必须显式补：父链 z-boot-parent:1.2.0 的 DM 把
             `spring-boot-starter-logging` 的子依赖**整条排除**（`*:*`，
             家族统一走 log4j2），而本仓只声明了 `log4j-api`（没有 provider）⇒
             容器里 **SLF4J 无任何 provider** ⇒ 启动日志被吞成
             `SLF4J(W): No SLF4J providers were found.`，
             连 debug 模式的 CONDITIONS EVALUATION REPORT 都打不出来（实测）。
             宿主 z-opc 的做法是直接钉 `log4j-slf4j2-impl`（唯一 provider）；
             本仓同口径。
             ⚠ 三件（api / core / slf4j2-impl）必须**同版** —— 根 pom 的
             `log4j2.version` 是 2.22.1，但本机离线仓里 slf4j2-impl 没有 2.22.1
             （只有 2.20.0 / 2.23.1 / 2.25.4 / 2.25.5 / 2.26.1）⇒ 这里显式钉
             **2.25.4**（父链地板版本，本地齐），并在下面把 `log4j-api` 一并抬到同版，
             免得 api 2.22.1 与 core 2.25.4 跨小版本混装。 -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.25.4</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.25.4</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>2.25.4</version>
        </dependency>

        <!-- Spring Boot Starters（默认 Logback；slf4j-simple transitive 防御性排除留着——
             源仓（z-vector 等）已清洁，本格未来可摘） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <!-- 显式覆盖 Jackson 版本（z-vector 等传递的旧版与 knife4j 冲突） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>2.15.4</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.15.4</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>2.15.4</version>
        </dependency>

        <!-- 数据库驱动（provided：按需引入） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- 原显式 slf4j-api 1.7.36 直条目已删（2026-10-02）：版本字面值与根 pom DM 的
             ${slf4j.version}=2.0.13 冲突且无 main 引用——z-***REMOVED***-web 与 spring-boot-starter 的
             传递 slf4j-api 已经够了，直条目是噪声。 -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>com.zifang.z.***REMOVED***.bootstrap.***REMOVED***Application</mainClass>
                    <!-- 原 <excludes>slf4j-simple</excludes> 已删（2026-10-02）：上面 provided
                         声明同时没了，fat jar 没有任何东西要再显式排除；留着是误以为有 binding 要滤。 -->
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
