<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.yuku123</groupId>
            <artifactId>z-kb</artifactId>
        <version>1.0.1</version>
    </parent>
    <groupId>io.github.yuku123</groupId>
    <version>1.0.1</version>

    <artifactId>z-kb-bootstrap</artifactId>
    <packaging>jar</packaging>
    <name>z-kb-bootstrap</name>
    <description>
        z-kb 启动器 — 独立可执行的 Spring Boot 应用，默认端口 8889。
        集成所有 z-kb 子模块 + Knife4j，开箱即用。
    </description>

    <url>https://github.com/yuku123/z-kb</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-team</organization>
            <organizationUrl>https://github.com/yuku123</organizationUrl>
            <timezone>+08:00</timezone>
            <roles>
                <role>owner</role>
            </roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/yuku123/z-kb.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/yuku123/z-kb.git</developerConnection>
        <url>https://github.com/yuku123/z-kb</url>
        <tag>HEAD</tag>
    </scm>



    <dependencies>
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-kb-web</artifactId>
        </dependency>

        <!-- Spring Boot Starters（默认 Logback；slf4j-simple transitive 防御性排除留着——
             源仓（z-vector 等）已清洁，本格未来可摘） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <version>2.7.12</version>
            <exclusions>
                <exclusion>
                    <groupId>org.slf4j</groupId>
                    <artifactId>slf4j-simple</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <version>2.7.12</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
            <version>2.7.12</version>
        </dependency>
        <!-- 显式覆盖 Jackson 版本（z-vector 等传递的旧版与 knife4j 冲突） -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>2.15.4</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.15.4</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
            <version>2.15.4</version>
        </dependency>

        <!-- 数据库驱动（provided：按需引入） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <version>2.7.12</version>
            <scope>test</scope>
        </dependency>

        <!-- 原显式 slf4j-api 1.7.36 直条目已删（2026-10-02）：版本字面值与根 pom DM 的
             ${slf4j.version}=2.0.13 冲突且无 main 引用——z-kb-web 与 spring-boot-starter 的
             传递 slf4j-api 已经够了，直条目是噪声。 -->
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>com.zifang.z.kb.bootstrap.ZKbBootstrapApplication</mainClass>
                    <!-- 原 <excludes>slf4j-simple</excludes> 已删（2026-10-02）：上面 provided
                         声明同时没了，fat jar 没有任何东西要再显式排除；留着是误以为有 binding 要滤。 -->
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
