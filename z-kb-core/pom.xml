    <version>1.0.1</version>

    <artifactId>z-kb-core</artifactId>
    <packaging>jar</packaging>
    <name>z-kb-core</name>
    <description>
        z-kb 核心引擎:
        - parser: Markdown 解析 (frontmatter / wikilink / 标题 / 代码块 / 表格)
        - chunker: 标题感知 + Token 感知智能分块
        - extractor: 基于规则 + 共现窗口的实体关系抽取
        - embedding: Embedding 接口 + TF-IDF 本地实现 + HTTP 远程实现
        - search: BM25 全文检索
    </description>

    <url>https://github.com/yuku123/z-kb</url>
